<Window x:Class="vehicles.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vehicles.wpf"
        xmlns:res="clr-namespace:vehicles.wpf.Properties;assembly=vehicles.wpf"
        mc:Ignorable="d"
        Title="{x:Static res:Resources.Str_Title}"
        Height="580"
        Width="940"
        MinWidth="900"
        MinHeight="550">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F7F5" Offset="0"/>
            <GradientStop Color="#E4E4E1" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- ===== Color tokens ===== -->
        <Color x:Key="PrimaryColor">#0A4FD6</Color>
        <SolidColorBrush x:Key="Primary" Color="#0A4FD6"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#2B6AE6"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#0A3CA8"/>
        <SolidColorBrush x:Key="PrimarySoft" Color="#E3ECFC"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111315"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4A4F55"/>
        <SolidColorBrush x:Key="BorderBrushToken" Color="#B5B8BD"/>
        <SolidColorBrush x:Key="Danger" Color="#C62828"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FBE9E9"/>

        <!-- ===== Radius tokens ===== -->
        <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="RadiusLarge">16</CornerRadius>

        <!-- ===== Elevation ===== -->
        <DropShadowEffect x:Key="Elevation2" Color="#000000" Opacity="0.14"
                          BlurRadius="24" ShadowDepth="6" Direction="270"/>
        <DropShadowEffect x:Key="FocusGlow" Color="#0A4FD6" Opacity="0.45"
                          BlurRadius="10" ShadowDepth="0"/>

        <!-- ===== Typography ===== -->
        <Style x:Key="Headline1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="Headline2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- ===== Card ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Effect" Value="{StaticResource FocusGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}"/>
                    <Setter Property="Effect" Value="{StaticResource FocusGlow}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryPressed}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3D6BC9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Input ===== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource Surface}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                    <Setter Property="Effect" Value="{StaticResource FocusGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== List items ===== -->
        <Style x:Key="VehicleItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dot" Width="8" Height="8" Margin="0,0,12,0"
                                         Fill="{StaticResource BorderBrushToken}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F3F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimarySoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="10,4,10,6">
            <TextBlock Text="{x:Static res:Resources.Str_Title}" Style="{StaticResource Headline1}"/>
            <TextBlock Text="{x:Static res:Resources.Str_Description}"
                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CARD: vehicle list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static res:Resources.Str_Vehicles}" Style="{StaticResource Headline2}"
                               Margin="0,0,0,14"/>

                    <ListBox Grid.Row="1" x:Name="VehicleList" BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding Vehicles}"
                             DisplayMemberPath="Name"
                             ItemContainerStyle="{StaticResource VehicleItem}"/>

                    <UniformGrid Grid.Row="2" Rows="1" Margin="0,14,0,0">
                        <Button x:Name="AddCarButton" Content="{x:Static res:Resources.Str_AddCar}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,5,0" Click="AddCar_Click"/>
                        <Button x:Name="AddBoatButton" Content="{x:Static res:Resources.Str_AddBoat}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="5,0,0,0" Click="AddBoat_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- RIGHT CARD: details, actions, log -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="SelectedText" d:Text="Valitud: Volvo V60"
                               Style="{StaticResource Headline2}"/>

                    <!-- Mileage chip -->
                    <Border Background="{StaticResource PrimarySoft}" CornerRadius="12"
                            Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock x:Name="MileageText" d:Text="Läbisõit: 120 km"
                                   Foreground="{StaticResource Primary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Distance input -->
                    <TextBlock Text="{x:Static res:Resources.Str_Distance}" Style="{StaticResource Subtitle}"
                               Margin="0,22,0,6"/>
                    <TextBox x:Name="DistanceBox" Text="10" Width="140"
                             HorizontalAlignment="Left" Style="{StaticResource InputBox}"/>

                    <!-- Actions (Visibility can be driven by IDriveable / ISwimmable) -->
                    <UniformGrid Rows="1" Margin="0,18,0,0">
                        <Button x:Name="DriveButton" Content="{x:Static res:Resources.Str_Drive}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,6,0" Click="Drive_Click"/>
                        <Button x:Name="SwimButton" Content="{x:Static res:Resources.Str_Swim}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="6,0,6,0" Click="Swim_Click"/>
                        <Button x:Name="RemoveButton" Content="{x:Static res:Resources.Str_Remove}"
                                Style="{StaticResource DangerButton}"
                                Margin="6,0,0,0" Click="Remove_Click"/>
                    </UniformGrid>

                    <!-- Activity log (info alert style) -->
                    <TextBlock Text="{x:Static res:Resources.Str_ActivityLog}" Style="{StaticResource Subtitle}"
                               Margin="0,26,0,8"/>
                    <Border Background="#EAF1FD" BorderBrush="#7FA6EE" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="14,12"
                            MinHeight="84">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{StaticResource Primary}"
                                    VerticalAlignment="Top" Margin="0,1,12,0">
                                <TextBlock Text="i" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="LogText" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}"
                                       d:Text="Volvo sõitis 10 km.&#x0A;Läbisõit: 130 km."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
